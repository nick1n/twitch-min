{
  "manifest_version": 3,
  "name": "twitch-min",
  "homepage_url": "https://github.com/nick1n/twitch-min",
  "version": "0.27.0",
  "description": "A browser extension that hides Twitch promos, shrinks the sidebar, and simplifies chat to keep the video and chat the main focus.",
  "minimum_chrome_version": "106",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.twitch.tv/*", "https://twitch.tv/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "twitch-min",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"],
    "js": ["shared/settings.js", "shared/selectors.js", "shared/runtime.js", "shared/regions.js", "styles/rules-sidebar.js", "styles/rules-navigation.js", "styles/rules-player.js", "styles/rules-chat.js", "styles/rules.js", "controllers/emotes.js", "controllers/layout.js", "controllers/timestamps.js", "controllers/player.js", "controllers/chat-badges.js", "controllers/chat.js", "controllers/composer.js", "content.js"],
    "css": ["styles/emotes.css", "styles/player.css"],
    "run_at": "document_start"
  }]
}
