{
  "manifest_version": 3,
  "name": "twitch-min",
  "version": "0.1.16",
  "description": "Compact Twitch sidebar with viewer counts and games, hide distractions, and preview chat emotes at 3x.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "twitch-min",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"],
    "js": ["settings.js", "rules.js", "emotes.js", "layout.js", "timestamps.js", "player.js", "chat.js", "composer.js", "content.js"],
    "css": ["emotes.css", "player.css"],
    "run_at": "document_start"
  }]
}
